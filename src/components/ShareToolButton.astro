---
interface Props {
	toolName: string;
	toolDescription: string;
	toolUrl: string;
}

const { toolName, toolDescription, toolUrl } = Astro.props;

// ID determinístico seguro basado en hash alfanumérico limpio
const sanitizedSlug = toolUrl.replace(/[^a-zA-Z0-9]/g, "-").replace(/-+/g, "-").toLowerCase();
const uniqueId = `share-btn-${sanitizedSlug}`;
---

<div class="share-tool-button-wrapper">
	<button
		id={uniqueId}
		type="button"
		class="share-tool-button"
		aria-label={`Compartir ${toolName}`}
		aria-haspopup="dialog"
		aria-expanded="false"
		aria-controls={`${uniqueId}-portal`}
		data-tool-name={toolName}
		data-tool-description={toolDescription}
		data-tool-url={toolUrl}
	>
		<svg
			class="share-icon"
			width="14"
			height="14"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<circle cx="18" cy="5" r="3"></circle>
			<circle cx="6" cy="12" r="3"></circle>
			<circle cx="18" cy="19" r="3"></circle>
			<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
			<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
		</svg>
		<span>Compartir</span>
	</button>
</div>

<script is:inline define:vars={{ uniqueId, toolName, toolDescription, toolUrl }}>
	(function () {
		"use strict";

		// =========================================================================
		// 1. GESTOR GLOBAL DE INSTANCIAS Y CICLO DE VIDA SPA (SWUP + ASTRO)
		// =========================================================================
		if (!window.__shareGlobalState) {
			window.__shareGlobalState = {
				instances: new Map(),
				cleanupAll: function () {
					window.__shareGlobalState.instances.forEach(function (destroy) {
						try {
							destroy();
						} catch {}
					});
					window.__shareGlobalState.instances.clear();
					document.querySelectorAll(".share-popup-portal").forEach(function (portal) {
						portal.remove();
					});
				},
				initAll: function () {
					document.querySelectorAll(".share-tool-button[id]").forEach(function (btn) {
						initBtn(btn.id);
					});
				},
			};

			const swup = window.swup;
			if (swup && swup.hooks) {
				swup.hooks.on("visit:start", window.__shareGlobalState.cleanupAll);
				swup.hooks.on("content:replace", window.__shareGlobalState.initAll);
			} else {
				document.addEventListener("swup:enable", function () {
					const s = window.swup;
					if (s && s.hooks) {
						s.hooks.on("visit:start", window.__shareGlobalState.cleanupAll);
						s.hooks.on("content:replace", window.__shareGlobalState.initAll);
					}
				}, { once: true });
			}

			document.addEventListener("astro:before-swap", window.__shareGlobalState.cleanupAll);
			document.addEventListener("astro:page-load", window.__shareGlobalState.initAll);
		}

		initBtn(uniqueId);

		// =========================================================================
		// 2. HELPERS DE RED Y RESOLUCIÓN CANÓNICA
		// =========================================================================
		function resolveAbsoluteUrl(rawUrl) {
			try {
				return new URL(rawUrl || window.location.pathname, window.location.origin).href;
			} catch {
				const fallbackPath = rawUrl ? (rawUrl.startsWith("/") ? rawUrl : "/" + rawUrl) : "";
				return window.location.origin + fallbackPath;
			}
		}

		function getShareUrl(platform, canonicalUrl, text) {
			const encodedUrl = encodeURIComponent(canonicalUrl);
			const encodedText = encodeURIComponent(text);

			switch (platform) {
				case "telegram":
					// FIX CRÍTICO: 'telegram.me' en lugar de 't.me' para evadir bloqueos de DNS locales (DNS_PROBE_POSSIBLE)
					return `https://telegram.me/share/url?url=${encodedUrl}&text=${encodedText}`;
				case "whatsapp":
					return `https://api.whatsapp.com/send?text=${encodedText}%20${encodedUrl}`;
				case "facebook":
					return `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
				case "twitter":
					return `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`;
				case "linkedin":
					return `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
				default:
					return canonicalUrl;
			}
		}

		function openCleanTab(targetUrl) {
			try {
				const newWin = window.open(targetUrl, "_blank", "noopener,noreferrer");
				if (!newWin) {
					console.warn("Apertura de pestaña bloqueada por el navegador.");
				}
			} catch (e) {
				console.error("Error al abrir pestaña:", e);
			}
		}

		function syncTheme(el) {
			const rootStyles = getComputedStyle(document.documentElement);
			const hue = rootStyles.getPropertyValue("--hue").trim() || "250";
			el.style.setProperty("--hue", hue);
			el.classList.toggle("dark", document.documentElement.classList.contains("dark"));
		}

		// =========================================================================
		// 3. INICIALIZACIÓN ATÓMICA DEL BOTÓN
		// =========================================================================
		function initBtn(id) {
			const btn = document.getElementById(id);
			if (!btn) return;

			const existingDestroy = window.__shareGlobalState.instances.get(id);
			if (existingDestroy) {
				existingDestroy();
			}

			const oldPortal = document.getElementById(id + "-portal");
			if (oldPortal) {
				oldPortal.remove();
			}

			const dataName = btn.dataset.toolName || toolName || "";
			const dataDesc = btn.dataset.toolDescription || toolDescription || "";
			const dataUrl = btn.dataset.toolUrl || toolUrl || "";
			
			const absUrl = resolveAbsoluteUrl(dataUrl);
			const shareText = `¡Mira esta herramienta gratuita: ${dataName}! ${dataDesc} 🚀`;

			const hasNativeShare =
				typeof navigator.share === "function" &&
				(typeof navigator.canShare !== "function" || (() => {
					try {
						return navigator.canShare({ url: absUrl });
					} catch {
						return false;
					}
				})());
			const isTouchDevice = "ontouchstart" in window || navigator.maxTouchPoints > 0;

			const portal = document.createElement("div");
			portal.id = id + "-portal";
			portal.className = "share-popup-portal";
			portal.setAttribute("role", "dialog");
			portal.setAttribute("aria-modal", "true");
			portal.setAttribute("aria-label", `Opciones para compartir ${dataName}`);
			syncTheme(portal);

			portal.innerHTML = `
				<div class="spp-inner">
					<button type="button" class="spp-option" data-platform="telegram" aria-label="Compartir en Telegram">
						<span class="spp-icon" style="background:#0088cc">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
								<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
							</svg>
						</span>
						<span>Telegram</span>
					</button>
					<button type="button" class="spp-option" data-platform="whatsapp" aria-label="Compartir en WhatsApp">
						<span class="spp-icon" style="background:#25D366">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
								<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
							</svg>
						</span>
						<span>WhatsApp</span>
					</button>
					<button type="button" class="spp-option" data-platform="twitter" aria-label="Compartir en X (Twitter)">
						<span class="spp-icon spp-icon-x">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
							</svg>
						</span>
						<span>X (Twitter)</span>
					</button>
					<button type="button" class="spp-option" data-platform="facebook" aria-label="Compartir en Facebook">
						<span class="spp-icon" style="background:#1877F2">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</span>
						<span>Facebook</span>
					</button>
					<button type="button" class="spp-option" data-platform="linkedin" aria-label="Compartir en LinkedIn">
						<span class="spp-icon" style="background:#0A66C2">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="white" aria-hidden="true">
								<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
							</svg>
						</span>
						<span>LinkedIn</span>
					</button>
					<button type="button" class="spp-option spp-copy-btn" data-platform="copy" aria-label="Copiar enlace al portapapeles">
						<span class="spp-icon spp-icon-copy">
							<svg class="spp-copy-default" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
							<svg class="spp-copy-check" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="20 6 9 17 4 12"></polyline>
							</svg>
						</span>
						<span class="spp-copy-text">Copiar</span>
					</button>
				</div>
			`;

			document.body.appendChild(portal);

			// =========================================================================
			// 4. POSICIONAMIENTO EN ESCRITORIO
			// =========================================================================
			function positionPopup() {
				if (window.innerWidth <= 640) return;

				const r = btn.getBoundingClientRect();
				const popupWidth = 300;
				const margin = 12;
				const popupHeight = portal.offsetHeight || 190;

				let top = r.bottom + 8;
				if (top + popupHeight + margin > window.innerHeight) {
					top = Math.max(margin, r.top - popupHeight - 8);
				}

				let left = r.right - popupWidth;
				if (left < margin) left = margin;
				if (left + popupWidth > window.innerWidth - margin) {
					left = window.innerWidth - popupWidth - margin;
				}

				portal.style.top = `${Math.round(top)}px`;
				portal.style.left = `${Math.round(left)}px`;
			}

			// =========================================================================
			// 5. APERTURA Y CIERRE
			// =========================================================================
			let isOpen = false;

			function openPortal() {
				document.querySelectorAll(".share-popup-portal").forEach(function (p) {
					if (p !== portal && p._shareCloseFn) p._shareCloseFn();
				});

				syncTheme(portal);
				portal.classList.add("share-popup-visible");
				btn.setAttribute("aria-expanded", "true");
				isOpen = true;

				positionPopup();

				const firstOption = portal.querySelector(".spp-option");
				if (firstOption) {
					setTimeout(() => firstOption.focus(), 50);
				}
			}

			function closePortal() {
				portal.classList.remove("share-popup-visible");
				btn.setAttribute("aria-expanded", "false");
				isOpen = false;

				if (document.activeElement && portal.contains(document.activeElement)) {
					btn.focus();
				}
			}

			portal._shareCloseFn = closePortal;

			// =========================================================================
			// 6. CONTROLADORES DE EVENTOS
			// =========================================================================
			function onBtnClick(e) {
				e.preventDefault();
				e.stopPropagation();

				if (isTouchDevice && hasNativeShare) {
					navigator.share({
						title: dataName,
						text: shareText,
						url: absUrl,
					}).catch(function (err) {
						if (err && err.name !== "AbortError") {
							isOpen ? closePortal() : openPortal();
						}
					});
					return;
				}

				isOpen ? closePortal() : openPortal();
			}

			function onOptionClick(e) {
				e.preventDefault();
				e.stopPropagation();
				const platform = this.getAttribute("data-platform");

				if (platform === "copy") {
					copyToClipboard(this, absUrl);
					return;
				}

				if (platform === "telegram") {
					// Disparo dual: Si está en móvil o desktop con app, invocar protocolo nativo tg://
					const tgDeepLink = `tg://msg_url?url=${encodeURIComponent(absUrl)}&text=${encodeURIComponent(shareText)}`;
					const fallbackWebUrl = getShareUrl("telegram", absUrl, shareText);
					
					// Intentar abrir app local primero
					const iframe = document.createElement("iframe");
					iframe.style.display = "none";
					document.body.appendChild(iframe);
					iframe.src = tgDeepLink;
					
					setTimeout(function () {
						iframe.remove();
					}, 300);

					// Abrir paralelamente el mirror no bloqueado en nueva pestaña
					openCleanTab(fallbackWebUrl);
					closePortal();
					return;
				}

				const targetShareUrl = getShareUrl(platform, absUrl, shareText);
				openCleanTab(targetShareUrl);
				closePortal();
			}

			function copyToClipboard(button, textToCopy) {
				const textEl = button.querySelector(".spp-copy-text");
				const iconDef = button.querySelector(".spp-copy-default");
				const iconChk = button.querySelector(".spp-copy-check");

				function showOk() {
					if (textEl) textEl.textContent = "¡Copiado!";
					if (iconDef) iconDef.style.display = "none";
					if (iconChk) iconChk.style.display = "block";
					button.classList.add("spp-copy-success");
					setTimeout(function () {
						if (textEl) textEl.textContent = "Copiar";
						if (iconDef) iconDef.style.display = "";
						if (iconChk) iconChk.style.display = "none";
						button.classList.remove("spp-copy-success");
					}, 2000);
				}

				function fallback() {
					try {
						const ta = document.createElement("textarea");
						ta.value = textToCopy;
						ta.setAttribute("readonly", "");
						ta.style.cssText = "position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;pointer-events:none;";
						document.body.appendChild(ta);
						ta.focus();
						ta.select();
						const ok = document.execCommand("copy");
						document.body.removeChild(ta);
						if (ok) showOk();
					} catch {}
				}

				if (navigator.clipboard && navigator.clipboard.writeText) {
					navigator.clipboard.writeText(textToCopy).then(showOk).catch(fallback);
				} else {
					fallback();
				}
			}

			function onDocClick(e) {
				if (
					isOpen &&
					!e.target.closest(".share-tool-button-wrapper") &&
					!e.target.closest(".share-popup-portal")
				) {
					closePortal();
				}
			}

			function onKeydown(e) {
				if (!isOpen) return;

				if (e.key === "Escape") {
					e.preventDefault();
					closePortal();
					return;
				}

				if (e.key === "Tab") {
					const focusable = portal.querySelectorAll(".spp-option");
					if (focusable.length === 0) return;
					const first = focusable[0];
					const last = focusable[focusable.length - 1];

					if (e.shiftKey && document.activeElement === first) {
						e.preventDefault();
						last.focus();
					} else if (!e.shiftKey && document.activeElement === last) {
						e.preventDefault();
						first.focus();
					}
				}
			}

			function onViewportChange() {
				if (isOpen) {
					positionPopup();
				}
			}

			btn.addEventListener("click", onBtnClick);
			portal.querySelectorAll(".spp-option").forEach(function (opt) {
				opt.addEventListener("click", onOptionClick);
			});
			document.addEventListener("click", onDocClick);
			document.addEventListener("keydown", onKeydown);
			window.addEventListener("scroll", onViewportChange, { passive: true });
			window.addEventListener("resize", onViewportChange, { passive: true });

			const destroy = function () {
				portal.remove();
				btn.removeEventListener("click", onBtnClick);
				document.removeEventListener("click", onDocClick);
				document.removeEventListener("keydown", onKeydown);
				window.removeEventListener("scroll", onViewportChange);
				window.removeEventListener("resize", onViewportChange);
				portal._shareCloseFn = null;
				window.__shareGlobalState.instances.delete(id);
			};

			window.__shareGlobalState.instances.set(id, destroy);
		}
	})();
</script>

<noscript>
	<style>
		.share-tool-button-wrapper { display: none; }
	</style>
</noscript>

<style>
	.share-tool-button-wrapper {
		position: relative;
		display: inline-flex;
	}

	.share-tool-button {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		padding: 0.3rem 0.65rem;
		border-radius: 9999px;
		background: oklch(0.93 0.04 var(--hue));
		color: oklch(0.45 0.14 var(--hue));
		border: none;
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
		-webkit-tap-highlight-color: transparent;
		user-select: none;
		touch-action: manipulation;
		font-family: inherit;
		transform: translateZ(0);
	}

	:global(.dark) .share-tool-button {
		background: oklch(0.3 0.05 var(--hue));
		color: oklch(0.82 0.12 var(--hue));
	}

	.share-tool-button:hover {
		background: oklch(0.88 0.06 var(--hue));
		color: oklch(0.45 0.16 var(--hue));
		transform: scale(1.04);
	}

	:global(.dark) .share-tool-button:hover {
		background: oklch(0.35 0.07 var(--hue));
		color: oklch(0.85 0.14 var(--hue));
	}

	.share-tool-button:active {
		transform: scale(0.96);
	}

	.share-tool-button:focus-visible {
		outline: 2px solid oklch(0.6 0.18 var(--hue));
		outline-offset: 2px;
	}

	.share-icon {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
	}
</style>

<style is:global>
	.share-popup-portal {
		position: fixed;
		width: 300px;
		background: oklch(0.99 0.005 var(--hue, 250));
		border-radius: 1rem;
		padding: 0.75rem;
		box-shadow: 0 10px 38px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.06);
		border: 1px solid rgba(0, 0, 0, 0.06);
		z-index: 99999;
		opacity: 0;
		transform: translateY(-6px) scale(0.98);
		pointer-events: none;
		visibility: hidden;
		transition: opacity 0.18s cubic-bezier(0.16, 1, 0.3, 1), transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 0.18s;
		box-sizing: border-box;
