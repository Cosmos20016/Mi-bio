---
/**
 * GlobalStyles.astro
 * Sistema de diseño global del sitio.
 * - Define tokens de diseño (custom properties)
 * - Reset CSS minimalista
 * - Dark mode automático + manual
 * - Tipografía base con system font stack
 * - Accesibilidad: reduced motion, high contrast, focus visible
 * - Performance: GPU promotion, smooth scroll condicional
 */
---

<style is:global>
  /* ============================================
     1. DESIGN TOKENS
     ============================================ */
  :root {
    /* ---- Hue & Theme ---- */
    --hue: 250;
    --hue-rotate: 0deg;

    /* ---- Color tokens (Light mode) ---- */
    --color-bg: #ffffff;
    --color-bg-elevated: #f8fafc;
    --color-bg-muted: #f1f5f9;
    --color-bg-subtle: #f8fafc;
    --color-bg-inverse: #0f172a;

    --color-text: #0f172a;
    --color-text-muted: #475569;
    --color-text-subtle: #64748b;
    --color-text-inverse: #f8fafc;

    --color-border: rgba(15, 23, 42, 0.08);
    --color-border-strong: rgba(15, 23, 42, 0.16);
    --color-border-inverse: rgba(248, 250, 252, 0.12);

    --color-card-bg: #ffffff;
    --color-card-border: rgba(15, 23, 42, 0.06);
    --color-card-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);

    /* ---- Brand colors (dinámicos según --hue) ---- */
    --color-brand-50: oklch(0.97 0.02 var(--hue));
    --color-brand-100: oklch(0.94 0.04 var(--hue));
    --color-brand-200: oklch(0.88 0.07 var(--hue));
    --color-brand-300: oklch(0.80 0.10 var(--hue));
    --color-brand-400: oklch(0.72 0.13 var(--hue));
    --color-brand-500: oklch(0.65 0.16 var(--hue));
    --color-brand-600: oklch(0.58 0.18 var(--hue));
    --color-brand-700: oklch(0.50 0.18 var(--hue));
    --color-brand-800: oklch(0.42 0.16 var(--hue));
    --color-brand-900: oklch(0.34 0.14 var(--hue));

    /* ---- Semantic colors ---- */
    --color-success: oklch(0.65 0.15 150);
    --color-warning: oklch(0.75 0.15 75);
    --color-error: oklch(0.60 0.20 25);
    --color-info: oklch(0.65 0.15 220);

    /* ---- Spacing scale (rem) ---- */
    --space-0: 0;
    --space-1: 0.25rem;
    --space-2: 0.5rem;
    --space-3: 0.75rem;
    --space-4: 1rem;
    --space-5: 1.25rem;
    --space-6: 1.5rem;
    --space-8: 2rem;
    --space-10: 2.5rem;
    --space-12: 3rem;
    --space-16: 4rem;
    --space-20: 5rem;
    --space-24: 6rem;

    /* ---- Radii ---- */
    --radius-sm: 0.375rem;
    --radius-md: 0.5rem;
    --radius-lg: 0.75rem;
    --radius-xl: 1rem;
    --radius-2xl: 1.5rem;
    --radius-full: 9999px;

    /* ---- Typography ---- */
    --font-sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
      "Helvetica Neue", Arial, sans-serif;
    --font-mono: ui-monospace, "SF Mono", "JetBrains Mono", Monaco, "Cascadia Code",
      "Roboto Mono", Consolas, "Courier New", monospace;

    --font-size-xs: 0.75rem;
    --font-size-sm: 0.875rem;
    --font-size-base: 1rem;
    --font-size-lg: 1.125rem;
    --font-size-xl: 1.25rem;
    --font-size-2xl: 1.5rem;
    --font-size-3xl: 1.875rem;
    --font-size-4xl: 2.25rem;
    --font-size-5xl: 3rem;

    --line-height-tight: 1.2;
    --line-height-snug: 1.35;
    --line-height-normal: 1.5;
    --line-height-relaxed: 1.65;

    --font-weight-normal: 400;
    --font-weight-medium: 500;
    --font-weight-semibold: 600;
    --font-weight-bold: 700;
    --font-weight-extrabold: 800;

    --letter-spacing-tight: -0.02em;
    --letter-spacing-snug: -0.01em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.025em;
    --letter-spacing-wider: 0.05em;

    /* ---- Shadows ---- */
    --shadow-xs: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-sm: 0 1px 3px rgba(15, 23, 42, 0.06), 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 4px 8px rgba(15, 23, 42, 0.06), 0 2px 4px rgba(15, 23, 42, 0.04);
    --shadow-lg: 0 10px 20px rgba(15, 23, 42, 0.08), 0 4px 8px rgba(15, 23, 42, 0.04);
    --shadow-xl: 0 20px 40px rgba(15, 23, 42, 0.10), 0 8px 16px rgba(15, 23, 42, 0.06);
    --shadow-2xl: 0 25px 50px rgba(15, 23, 42, 0.15);
    --shadow-glow: 0 0 20px oklch(0.70 0.14 var(--hue) / 0.3);

    /* ---- Z-index scale ---- */
    --z-base: 0;
    --z-dropdown: 100;
    --z-sticky: 200;
    --z-fixed: 300;
    --z-modal: 400;
    --z-popover: 500;
    --z-tooltip: 600;
    --z-toast: 700;
    --z-overlay: 99999;

    /* ---- Transitions ---- */
    --transition-fast: 150ms ease;
    --transition-normal: 200ms ease;
    --transition-slow: 300ms ease;
    --transition-smooth: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    --transition-bounce: 400ms cubic-bezier(0.34, 1.56, 0.64, 1);

    /* ---- Touch targets (a11y) ---- */
    --touch-target-min: 2.75rem; /* 44px */

    /* ---- Layout ---- */
    --content-max-width: 1280px;
    --content-padding: 1.5rem;
    --header-height: 4rem;
  }

  /* ============================================
     2. DARK MODE
     ============================================ */
  :root.dark,
  :root[data-theme="dark"] {
    --color-bg: #0a0a0f;
    --color-bg-elevated: #111118;
    --color-bg-muted: #18181f;
    --color-bg-subtle: #0f0f15;
    --color-bg-inverse: #f8fafc;

    --color-text: #f1f5f9;
    --color-text-muted: #94a3b8;
    --color-text-subtle: #64748b;
    --color-text-inverse: #0f172a;

    --color-border: rgba(248, 250, 252, 0.08);
    --color-border-strong: rgba(248, 250, 252, 0.16);
    --color-border-inverse: rgba(15, 23, 42, 0.12);

    --color-card-bg: #111118;
    --color-card-border: rgba(248, 250, 252, 0.08);
    --color-card-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);

    --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.2);
    --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3), 0 1px 2px rgba(0, 0, 0, 0.2);
    --shadow-md: 0 4px 8px rgba(0, 0, 0, 0.3), 0 2px 4px rgba(0, 0, 0, 0.2);
    --shadow-lg: 0 10px 20px rgba(0, 0, 0, 0.4), 0 4px 8px rgba(0, 0, 0, 0.2);
    --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.5), 0 8px 16px rgba(0, 0, 0, 0.3);
  }

  /* Auto dark mode si no hay preferencia explícita */
  @media (prefers-color-scheme: dark) {
    :root:not(.light):not([data-theme]) {
      --color-bg: #0a0a0f;
      --color-bg-elevated: #111118;
      --color-bg-muted: #18181f;
      --color-bg-subtle: #0f0f15;
      --color-bg-inverse: #f8fafc;

      --color-text: #f1f5f9;
      --color-text-muted: #94a3b8;
      --color-text-subtle: #64748b;
      --color-text-inverse: #0f172a;

      --color-border: rgba(248, 250, 252, 0.08);
      --color-border-strong: rgba(248, 250, 252, 0.16);
      --color-border-inverse: rgba(15, 23, 42, 0.12);

      --color-card-bg: #111118;
      --color-card-border: rgba(248, 250, 252, 0.08);
      --color-card-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);

      --shadow-xs: 0 1px 2px rgba(0, 0, 0, 0.2);
      --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.3), 0 1px 2px rgba(0, 0, 0, 0.2);
      --shadow-md: 0 4px 8px rgba(0, 0, 0, 0.3), 0 2px 4px rgba(0, 0, 0, 0.2);
      --shadow-lg: 0 10px 20px rgba(0, 0, 0, 0.4), 0 4px 8px rgba(0, 0, 0, 0.2);
      --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.5), 0 8px 16px rgba(0, 0, 0, 0.3);
    }
  }

  /* ============================================
     3. CSS RESET (moderno y minimalista)
     ============================================ */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    -webkit-text-size-adjust: 100%;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    scroll-behavior: smooth;
    /* Scroll padding para anclas con header sticky */
    scroll-padding-top: calc(var(--header-height) + 1rem);
    /* Safe areas para notch */
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }

  body {
    min-height: 100vh;
    min-height: 100dvh; /* Dynamic viewport (mobile Safari) */
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--font-size-base);
    line-height: var(--line-height-normal);
    font-feature-settings: "cv02", "cv03", "cv04", "cv11"; /* Inter ligaduras */
    transition: background-color var(--transition-normal), color var(--transition-normal);
    overflow-x: hidden;
    text-wrap: pretty; /* Mejor distribución de texto */
  }

  /* ============================================
     4. ELEMENTOS BASE
     ============================================ */
  h1, h2, h3, h4, h5, h6 {
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-snug);
    color: var(--color-text);
    text-wrap: balance; /* Mejor distribución de headings */
  }

  h1 { font-size: var(--font-size-4xl); }
  h2 { font-size: var(--font-size-3xl); }
  h3 { font-size: var(--font-size-2xl); }
  h4 { font-size: var(--font-size-xl); }
  h5 { font-size: var(--font-size-lg); }
  h6 { font-size: var(--font-size-base); }

  p {
    text-wrap: pretty;
  }

  a {
    color: var(--color-brand-600);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a:hover {
    color: var(--color-brand-700);
  }

  img, picture, video, canvas, svg {
    display: block;
    max-width: 100%;
    height: auto;
  }

  input, button, textarea, select {
    font: inherit;
    color: inherit;
  }

  button {
    background: none;
    border: none;
    cursor: pointer;
  }

  textarea {
    resize: vertical;
  }

  ul, ol {
    list-style: none;
  }

  code, pre, kbd, samp {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  ::selection {
    background-color: oklch(0.65 0.16 var(--hue) / 0.25);
    color: var(--color-text);
  }

  /* ============================================
     5. FOCUS VISIBLE (Accesibilidad)
     ============================================ */
  :focus {
    outline: none;
  }

  :focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Focus visible específico para inputs */
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 1px;
  }

  /* ============================================
     6. UTILIDADES
     ============================================ */

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* No scroll (cuando se abre un modal) */
  .no-scroll {
    overflow: hidden !important;
    touch-action: none;
  }

  /* Container */
  .container {
    width: 100%;
    max-width: var(--content-max-width);
    margin-inline: auto;
    padding-inline: var(--content-padding);
  }

  /* GPU promotion utility */
  .gpu {
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
  }

  /* Truncate */
  .truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ============================================
     7. SCROLLBAR (Sutil y premium)
     ============================================ */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--color-border-strong) transparent;
  }

  *::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  *::-webkit-scrollbar-track {
    background: transparent;
  }

  *::-webkit-scrollbar-thumb {
    background: var(--color-border-strong);
    border-radius: var(--radius-full);
    transition: background var(--transition-fast);
  }

  *::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-subtle);
  }

  /* ============================================
     8. ACCESIBILIDAD
     ============================================ */

  /* Reduce motion: desactiva todas las animaciones */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* High contrast: bordes más fuertes */
  @media (prefers-contrast: high) {
    :root {
      --color-border: rgba(15, 23, 42, 0.3);
      --color-border-strong: rgba(15, 23, 42, 0.5);
    }
    :root.dark {
      --color-border: rgba(248, 250, 252, 0.3);
      --color-border-strong: rgba(248, 250, 252, 0.5);
    }
    :focus-visible {
      outline-width: 3px;
    }
  }

  /* Forced colors (Windows High Contrast Mode) */
  @media (forced-colors: active) {
    :focus-visible {
      outline: 2px solid CanvasText;
    }
    button,
    a {
      forced-color-adjust: auto;
    }
  }

  /* ============================================
     9. PRINT
     ============================================ */
  @media print {
    *,
    *::before,
    *::after {
      background: transparent !important;
      color: #000 !important;
      box-shadow: none !important;
      text-shadow: none !important;
    }

    a,
    a:visited {
      text-decoration: underline;
    }

    a[href]::after {
      content: " (" attr(href) ")";
      font-size: 0.85em;
    }

    h1, h2, h3 {
      page-break-after: avoid;
    }

    img {
      max-width: 100% !important;
      page-break-inside: avoid;
    }

    pre, blockquote {
      border: 1px solid #000;
      page-break-inside: avoid;
    }
  }

  /* ============================================
     10. PREFERS-REDUCED-TRANSPARENCY
     ============================================ */
  @media (prefers-reduced-transparency: reduce) {
    *,
    *::before,
    *::after {
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
  }
</style>

<!--
  Script inline para sincronizar el tema con la preferencia del sistema
  y evitar el "flash of unstyled content" (FOUC).
  Se ejecuta antes del render para que el DOM ya tenga la clase correcta.
-->
<script is:inline>
  (function () {
    'use strict';
    try {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored || (prefersDark ? 'dark' : 'light');
      const root = document.documentElement;
      if (theme === 'dark') {
        root.classList.add('dark');
        root.classList.remove('light');
      } else {
        root.classList.add('light');
        root.classList.remove('dark');
      }
      root.setAttribute('data-theme', theme);
    } catch (e) {
      // Silenciar errores de localStorage
    }
  })();
</script>
