---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";

// =========================================================================
// TIPADO ESTRICTO E INMUTABLE
// =========================================================================
type IconType = "teleprompter" | "link" | "qr" | "image" | "text" | "palette";

interface ToolItem {
	readonly name: string;
	readonly description: string;
	readonly href: string;
	readonly iconType: IconType;
	readonly badge: string;
	readonly features: readonly string[];
	readonly hue: number;
	readonly keywords: readonly string[];
}

// =========================================================================
// REGISTRO DE HERRAMIENTAS DE PRODUCCIÓN
// =========================================================================
const tools: readonly ToolItem[] = [
	{
		name: "Teleprompter Studio",
		description:
			"Tu estudio profesional de lectura en pantalla. Velocidad precisa, espejo, focus mode, atajos de teclado y countdown.",
		href: url("/herramientas/teleprompter/"),
		iconType: "teleprompter",
		badge: "Pro",
		features: ["Modo espejo", "Focus mode", "Atajos de teclado", "Countdown"],
		hue: 220,
		keywords: ["teleprompter", "lector", "prompter"],
	},
	{
		name: "Acortador de URLs",
		description:
			"Acorta, organiza y gestiona tus enlaces. QR codes al instante, historial con estadísticas y exportación.",
		href: url("/herramientas/acortador/"),
		iconType: "link",
		badge: "Sin publicidad",
		features: ["QR Codes", "Categorías", "Sin publicidad", "Exportar JSON"],
		hue: 280,
		keywords: ["shortener", "url", "acortador"],
	},
] as const;

// =========================================================================
// RESOLUCIÓN DINÁMICA DE ENTORNO Y SEO
// =========================================================================
const siteOrigin = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, "");
const pageUrl = `${siteOrigin}/herramientas/`;
const pageTitle = "Herramientas";
const pageDescription = "Suite de herramientas profesionales gratuitas para creadores: teleprompter premium, acortador de URLs con QR y más.";
const pageKeywords = "herramientas, teleprompter, acortador urls, qr, gratis, sin publicidad";

// Schema.org ItemList con prevención estricta de XSS
const jsonLdPayload = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: pageTitle,
	description: pageDescription,
	url: pageUrl,
	numberOfItems: tools.length,
	itemListElement: tools.map((tool, idx) => ({
		"@type": "ListItem",
		position: idx + 1,
		item: {
			"@type": "WebApplication",
			name: tool.name,
			description: tool.description,
			url: `${siteOrigin}${tool.href}`,
			applicationCategory: "UtilityApplication",
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
			featureList: tool.features.join(", "),
		},
	})),
};

const jsonLdString = JSON.stringify(jsonLdPayload).replace(/</g, "\\u003c");
---

<MainGridLayout
	title={pageTitle}
	description={pageDescription}
	image={`${siteOrigin}/og-images/tools.png`}
	url={pageUrl}
	keywords={pageKeywords}
>
	<!-- Inyección segura de Schema JSON-LD -->
	<script type="application/ld+json" set:html={jsonLdString} is:inline />

	<div class="tools-hub-container">
		<section class="tools-hub-section" aria-labelledby="tools-title">
			<!-- HEADER -->
			<header class="tools-header">
				<div class="header-icon-wrap" aria-hidden="true">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						viewBox="0 0 100 100"
						class="header-icon"
					>
						<defs>
							<linearGradient id="tools-hub-header-grad" x1="0%" y1="0%" x2="100%" y2="100%">
								<stop offset="0%" class="grad-stop-1" />
								<stop offset="100%" class="grad-stop-2" />
							</linearGradient>
							<filter id="tools-hub-header-glow">
								<feGaussianBlur stdDeviation="2" result="coloredBlur" />
								<feMerge>
									<feMergeNode in="coloredBlur" />
									<feMergeNode in="SourceGraphic" />
								</feMerge>
							</filter>
						</defs>
						<polygon
							points="50,15 75,28 75,54 50,67 25,54 25,28"
							fill="none"
							stroke="url(#tools-hub-header-grad)"
							stroke-width="2"
							opacity="0.5"
							class="hex-outline"
						></polygon>
						<circle
							cx="50"
							cy="41"
							r="12"
							fill="url(#tools-hub-header-grad)"
							filter="url(#tools-hub-header-glow)"
							opacity="0.7"
							class="center-glow"
						></circle>
						<path
							d="M 50 33 L 52 38 L 57 39 L 53 43 L 54 48 L 50 45 L 46 48 L 47 43 L 43 39 L 48 38 Z"
							fill="white"
							opacity="0.9"
							class="star"
						></path>
						<circle cx="35" cy="30" r="2" fill="url(#tools-hub-header-grad)" class="dot d1"></circle>
						<circle cx="65" cy="30" r="2" fill="url(#tools-hub-header-grad)" class="dot d2"></circle>
						<circle cx="35" cy="52" r="2" fill="url(#tools-hub-header-grad)" class="dot d3"></circle>
						<circle cx="65" cy="52" r="2" fill="url(#tools-hub-header-grad)" class="dot d4"></circle>
					</svg>
				</div>

				<p class="header-eyebrow">Suite de herramientas</p>
				<h1 id="tools-title" class="tools-title">{pageTitle}</h1>
				<p class="tools-subtitle">
					Herramientas profesionales diseñadas para potenciar tu creatividad y flujo de trabajo.
				</p>

				<ul class="tools-pills" role="list" aria-label="Características del sitio">
					<li class="pill">
						<span class="pill-dot" aria-hidden="true"></span>
						{tools.length} herramientas
					</li>
					<li class="pill">
						<span class="pill-dot" aria-hidden="true"></span>
						100% gratuitas
					</li>
					<li class="pill">
						<span class="pill-dot" aria-hidden="true"></span>
						Sin publicidad
					</li>
				</ul>
			</header>

			<!-- GRID CON ESTIRAMIENTO SIMÉTRICO Y ANIMACIONES NATIVAS -->
			<ul class="tools-grid" role="list" aria-label="Lista de herramientas disponibles">
				{tools.map((tool, i) => (
					<li class="tool-card-wrapper" style={`--i: ${i};`}>
						<a
							class="tool-card"
							href={tool.href}
							style={`--hue-tool: ${tool.hue};`}
						>
							<div class="card-glow" aria-hidden="true"></div>

							<span class="card-badge">
								{tool.badge}
							</span>

							<div class="card-icon" aria-hidden="true">
								{tool.iconType === "teleprompter" && (
									<svg viewBox="0 0 64 64" class="icon-svg tele-icon">
										<rect x="8" y="10" width="48" height="32" rx="4" class="monitor-body" />
										<rect x="11" y="13" width="42" height="26" rx="2" class="monitor-screen" />
										<rect x="16" y="20" width="22" height="2.5" rx="1.25" class="tele-line l1" />
										<rect x="16" y="25.5" width="32" height="2.5" rx="1.25" class="tele-line l2" />
										<rect x="16" y="31" width="27" height="2.5" rx="1.25" class="tele-line l3" />
										<path
											d="M 46 22 L 50 26 M 50 26 L 54 22 M 50 26 L 50 36"
											stroke-width="2.5"
											stroke-linecap="round"
											stroke-linejoin="round"
											fill="none"
											class="tele-arrow"
										/>
										<rect x="28" y="42" width="8" height="4" rx="1" class="stand-neck" />
										<rect x="22" y="46" width="20" height="3" rx="1.5" class="stand-base" />
										<circle cx="14" cy="15" r="2" class="rec-dot" />
									</svg>
								)}
								{tool.iconType === "link" && (
									<svg viewBox="0 0 64 64" class="icon-svg link-icon">
										<rect x="6" y="16" width="52" height="10" rx="5" class="url-bar long-bar" />
										<rect x="10" y="19" width="8" height="4" rx="2" class="url-chunk c1" />
										<rect x="20" y="19" width="12" height="4" rx="2" class="url-chunk c2" />
										<rect x="34" y="19" width="9" height="4" rx="2" class="url-chunk c3" />
										<rect x="45" y="19" width="9" height="4" rx="2" class="url-chunk c4" />
										<path
											d="M 20 30 Q 10 38 10 38 Q 10 48 16 48"
											stroke-width="2"
											stroke-linecap="round"
											fill="none"
											class="arrow-path"
										/>
										<path
											d="M 44 30 Q 54 38 54 38 Q 54 48 48 48"
											stroke-width="2"
											stroke-linecap="round"
											fill="none"
											class="arrow-path"
										/>
										<rect x="14" y="38" width="36" height="10" rx="5" class="url-bar short-bar" />
										<circle cx="23" cy="43" r="3" fill="none" stroke-width="1.8" class="link-ring lr1" />
										<circle cx="29" cy="43" r="3" fill="none" stroke-width="1.8" class="link-ring lr2" />
										<line x1="25" y1="43" x2="27" y2="43" stroke-width="1.8" stroke-linecap="round" class="link-bridge" />
										<rect x="34" y="41.5" width="12" height="3" rx="1.5" class="short-text-bar" />
									</svg>
								)}
							</div>

							<div class="card-content">
								<h2 class="card-title">{tool.name}</h2>
								<p class="card-desc">{tool.description}</p>
							</div>

							<ul class="card-features" role="list" aria-label={`Características de ${tool.name}`}>
								{tool.features.map((f) => (
									<li class="feature-tag">
										<span class="feature-dot" aria-hidden="true">✦</span>
										{f}
									</li>
								))}
							</ul>

							<div class="card-cta" aria-hidden="true">
								<span class="cta-text">Abrir herramienta</span>
								<span class="cta-arrow">
									<svg viewBox="0 0 20 20" fill="none" width="16" height="16">
										<path
											d="M4 10h12M11 5l5 5-5 5"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									</svg>
								</span>
							</div>
						</a>
					</li>
				))}
			</ul>

			<!-- FOOTER -->
			<footer class="tools-footer">
				<div class="footer-card">
					<span class="footer-icon" aria-hidden="true">🔒</span>
					<p>
						Todas las herramientas funcionan directamente en tu navegador.
						<strong>Tus datos nunca salen de tu dispositivo.</strong>
					</p>
				</div>
			</footer>
		</section>
	</div>
</MainGridLayout>

<style>
	.tools-hub-container {
		--ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
		--text-primary: oklch(0.15 0.01 var(--hue));
		--text-secondary: oklch(0.45 0.02 var(--hue));
		--text-muted: oklch(0.6 0.02 var(--hue));
		--border: oklch(0.88 0.01 var(--hue));
		--bg-tag: oklch(0.95 0.01 var(--hue));
		--card-surface: #ffffff;
		--card-shadow:
			0 2px 12px oklch(0.4 0.1 var(--hue) / 0.08),
			0 1px 3px oklch(0.4 0.1 var(--hue) / 0.06);
		--card-shadow-hover:
			0 16px 40px oklch(0.4 0.1 var(--hue) / 0.14),
			0 4px 12px oklch(0.4 0.1 var(--hue) / 0.1);

		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
		contain: layout style;
		padding-left: max(0px, env(safe-area-inset-left));
		padding-right: max(0px, env(safe-area-inset-right));
	}

	:global(.dark) .tools-hub-container {
		--text-primary: oklch(0.95 0.01 var(--hue));
		--text-secondary: oklch(0.7 0.03 var(--hue));
		--text-muted: oklch(0.55 0.03 var(--hue));
		--border: oklch(0.28 0.03 var(--hue));
		--bg-tag: oklch(0.2 0.03 var(--hue));
		--card-surface: oklch(0.14 0.02 var(--hue));
		--card-shadow: 0 2px 12px rgb(0 0 0 / 0.3), 0 1px 3px rgb(0 0 0 / 0.25);
		--card-shadow-hover: 0 16px 40px rgb(0 0 0 / 0.5), 0 4px 12px rgb(0 0 0 / 0.4);
	}

	.tools-hub-section {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		animation: fadeUp 0.5s var(--ease-out) both;
	}

	.tools-header {
		text-align: center;
		padding: 1rem 0 0.25rem;
	}

	.header-icon-wrap {
		display: inline-flex;
		margin-bottom: 1rem;
		color: oklch(0.6 0.2 var(--hue));
		transform: translateZ(0);
	}

	.header-icon {
		width: 80px;
		height: 80px;
		animation: headerFloat 4s ease-in-out infinite;
		will-change: transform;
	}

	@keyframes headerFloat {
		0%, 100% { transform: translateY(0); }
		50% { transform: translateY(-6px); }
	}

	.grad-stop-1 { stop-color: oklch(0.7 0.2 var(--hue)); }
	.grad-stop-2 { stop-color: oklch(0.6 0.22 calc(var(--hue) + 40)); }

	.hex-outline {
		animation: hexBreath 4s ease-in-out infinite;
		transform-origin: 50px 41px;
	}
	@keyframes hexBreath {
		0%, 100% { transform: scale(1); opacity: 0.5; }
		50% { transform: scale(1.04); opacity: 0.7; }
	}

	.center-glow {
		animation: glowPulse 3s ease-in-out infinite;
		transform-origin: 50px 41px;
	}
	@keyframes glowPulse {
		0%, 100% { transform: scale(1); opacity: 0.7; }
		50% { transform: scale(1.08); opacity: 0.85; }
	}

	.star {
		animation: starSpin 14s linear infinite;
		transform-origin: 50px 41px;
		will-change: transform;
	}
	@keyframes starSpin {
		from { transform: rotate(0deg); }
		to { transform: rotate(360deg); }
	}

	.d1 { transform-origin: 35px 30px; animation: dotArc1 3s ease-in-out infinite; }
	.d2 { transform-origin: 65px 30px; animation: dotArc2 4s ease-in-out infinite 0.8s; }
	.d3 { transform-origin: 35px 52px; animation: dotArc3 3.5s ease-in-out infinite 1.5s; }
	.d4 { transform-origin: 65px 52px; animation: dotArc4 4.5s ease-in-out infinite 0.4s; }

	@keyframes dotArc1 {
		0%, 100% { opacity: 0.3; transform: translate(0, 0) scale(0.85); }
		50% { opacity: 0.95; transform: translate(-2px, -2px) scale(1.2); }
	}
	@keyframes dotArc2 {
		0%, 100% { opacity: 0.35; transform: translate(0, 0) scale(0.85); }
		50% { opacity: 1; transform: translate(2px, -2px) scale(1.25); }
	}
	@keyframes dotArc3 {
		0%, 100% { opacity: 0.3; transform: translate(0, 0) scale(0.85); }
		50% { opacity: 0.95; transform: translate(-2px, 2px) scale(1.2); }
	}
	@keyframes dotArc4 {
		0%, 100% { opacity: 0.25; transform: translate(0, 0) scale(0.8); }
		50% { opacity: 1; transform: translate(2px, 2px) scale(1.2); }
	}

	.header-eyebrow {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: oklch(0.6 0.2 var(--hue));
		margin-bottom: 0.4rem;
	}

	.tools-title {
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.15;
		margin: 0 0 0.6rem 0;
		color: oklch(0.55 0.22 var(--hue));
		background: linear-gradient(
			135deg,
			oklch(0.55 0.22 var(--hue)),
			oklch(0.65 0.2 calc(var(--hue) + 50))
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	:global(.dark) .tools-title {
		color: oklch(0.75 0.2 var(--hue));
		background: linear-gradient(
			135deg,
			oklch(0.75 0.2 var(--hue)),
			oklch(0.82 0.18 calc(var(--hue) + 50))
		);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.tools-subtitle {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--text-secondary);
		max-width: 32rem;
		margin: 0 auto 1.25rem;
		padding: 0 1rem;
	}

	.tools-pills {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.3rem 0.8rem;
		font-size: 0.78rem;
		font-weight: 600;
		border-radius: 999px;
		background: oklch(0.7 0.15 var(--hue) / 0.1);
		color: oklch(0.5 0.18 var(--hue));
		border: 1px solid oklch(0.7 0.15 var(--hue) / 0.2);
	}

	:global(.dark) .pill {
		background: oklch(0.7 0.15 var(--hue) / 0.15);
		color: oklch(0.75 0.15 var(--hue));
		border-color: oklch(0.7 0.15 var(--hue) / 0.25);
	}

	.pill-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: oklch(0.6 0.2 var(--hue));
	}

	/* =========================================================================
	   GRID Y HOMOGENEIDAD ESTRUCTURAL (FIX CRÍTICO DE ALTURA)
	   ========================================================================= */
	.tools-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
		align-items: stretch;
	}

	@media (min-width: 720px) {
		.tools-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
	}

	.tool-card-wrapper {
		display: flex;
		flex-direction: column;
		height: 100%;
		width: 100%;
		animation: cardIn 0.4s var(--ease-out) both;
		animation-delay: calc(0.08s * var(--i, 0));
	}

	.tool-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.75rem;
		background: var(--card-surface);
		border: 1px solid var(--border);
		border-radius: 1.25rem;
		text-decoration: none;
		color: inherit;
		overflow: hidden;
		box-shadow: var(--card-shadow);
		transition:
			transform 0.3s var(--ease-spring),
			box-shadow 0.3s var(--ease-out),
			border-color 0.25s ease;
		isolation: isolate;
		transform: translateZ(0);
		backface-visibility: hidden;
		width: 100%;
		height: 100%;
		flex: 1 1 auto;
		box-sizing: border-box;
	}

	@keyframes cardIn {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.card-glow {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(
			circle at 50% 0%,
			oklch(0.7 0.2 var(--hue-tool, var(--hue)) / 0.1),
			transparent 65%
		);
		opacity: 0;
		transition: opacity 0.3s ease;
		pointer-events: none;
		z-index: 0;
	}

	.tool-card:hover .card-glow { opacity: 1; }

	.tool-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--card-shadow-hover);
		border-color: oklch(0.7 0.15 var(--hue-tool, var(--hue)) / 0.35);
	}

	.tool-card:focus-visible {
		outline: 3px solid oklch(0.6 0.2 var(--hue));
		outline-offset: 3px;
	}

	.card-badge {
		position: absolute;
		top: 1.25rem;
		right: 1.25rem;
		padding: 0.25rem 0.65rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		border-radius: 999px;
		background: oklch(0.7 0.18 var(--hue-tool, var(--hue)) / 0.12);
		color: oklch(0.5 0.2 var(--hue-tool, var(--hue)));
		border: 1px solid oklch(0.7 0.18 var(--hue-tool, var(--hue)) / 0.25);
		z-index: 2;
	}

	:global(.dark) .card-badge {
		background: oklch(0.7 0.18 var(--hue-tool, var(--hue)) / 0.2);
		color: oklch(0.8 0.16 var(--hue-tool, var(--hue)));
		border-color: oklch(0.7 0.18 var(--hue-tool, var(--hue)) / 0.3);
	}

	.card-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 68px;
		height: 68px;
		border-radius: 1rem;
		background: oklch(0.7 0.15 var(--hue-tool, var(--hue)) / 0.1);
		border: 1px solid oklch(0.7 0.15 var(--hue-tool, var(--hue)) / 0.18);
		flex-shrink: 0;
		position: relative;
		z-index: 1;
		transition: transform 0.3s var(--ease-spring);
	}

	.tool-card:hover .card-icon {
		transform: scale(1.05);
	}

	:global(.dark) .card-icon {
		background: oklch(0.7 0.15 var(--hue-tool, var(--hue)) / 0.15);
