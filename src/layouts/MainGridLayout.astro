---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	image?: string;
	url?: string;
	keywords?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	jsonLd?: Record<string, unknown> | null;
}

const {
	title,
	banner,
	description,
	image,
	url: propUrl,
	keywords,
	lang,
	setOGTypeArticle,
	headings = [],
	jsonLd = null,
} = Astro.props;

const hasBannerCredit =
	Boolean(siteConfig.banner.enable) && Boolean(siteConfig.banner.credit.enable);
const hasBannerLink = Boolean(siteConfig.banner.credit.url);

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

// Resolución canónica segura y desacoplada
const siteOrigin = (Astro.site ? Astro.site.toString() : Astro.url.origin).replace(/\/$/, "");
const canonicalUrl = propUrl
	? (propUrl.startsWith("http") ? propUrl : `${siteOrigin}${propUrl.startsWith("/") ? "" : "/"}${propUrl}`)
	: `${siteOrigin}${Astro.url.pathname}`;

// Sanitización estricta anti-XSS para JSON-LD
const jsonLdString = jsonLd
	? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
	: null;
---

<Layout
	title={title}
	banner={banner}
	description={description}
	image={image}
	url={canonicalUrl}
	keywords={keywords}
	lang={lang}
	setOGTypeArticle={setOGTypeArticle}
>
	<!-- JSON-LD opcional sanitizado -->
	{jsonLdString && (
		<script
			type="application/ld+json"
			set:html={jsonLdString}
			is:inline
			slot="head"
		/>
	)}

	<!-- Slot para metadatos adicionales -->
	<slot slot="head" name="head" />

	<!-- Barra de navegación superior -->
	<div
		id="top-row"
		class="z-50 pointer-events-none relative max-w-[var(--page-width)] px-0 md:px-4 mx-auto"
	>
		<div
			id="navbar-wrapper"
			class="pointer-events-auto sticky top-0 transition-all duration-300"
		>
			<Navbar />
		</div>
	</div>

	<!-- Banner Hero -->
	{siteConfig.banner.enable && (
		<div
			id="banner-wrapper"
			class="absolute z-10 w-full transition duration-700 overflow-hidden"
			style={`top: -${BANNER_HEIGHT_EXTEND}vh;`}
		>
			<ImageWrapper
				id="banner"
				alt="Banner image of the blog"
				class:list={[
					"object-cover h-full transition duration-700 opacity-0 scale-105",
				]}
				src={siteConfig.banner.src}
				position={siteConfig.banner.position}
			/>
		</div>
	)}

	<!-- Contenedor del contenido principal -->
	<div
		class="absolute w-full z-30 pointer-events-none"
		style={`top: ${mainPanelTop};`}
	>
		<div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
			<!-- Cuadrícula estructural optimizada sin layout thrashing -->
			<div
				id="main-grid"
				class="w-full grid grid-cols-1 lg:grid-cols-[17.5rem_1fr] mx-auto gap-4 px-0 md:px-4"
			>
				<!-- Créditos del banner -->
				{hasBannerCredit && (
					<a
						href={siteConfig.banner.credit.url || "#"}
						id="banner-credit"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Visitar fuente de la imagen"
						class:list={[
							"group onload-animation transition-all absolute flex justify-center items-center rounded-full px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9",
							{ "hover:pr-9 active:bg-black/80": hasBannerLink },
						]}
					>
						<Icon
							class="text-white/75 text-[1.25rem] mr-1"
							name="material-symbols:copyright-outline-rounded"
						/>
						<div class="text-white/75 text-xs">
							{siteConfig.banner.credit.text}
						</div>
						{hasBannerLink && (
							<Icon
								class="transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0 group-hover:opacity-100"
								name="fa6-solid:arrow-up-right-from-square"
							/>
						)}
					</a>
				)}

				<!-- Barra lateral izquierda -->
				<SideBar
					class="mb-4 lg:mb-0 lg:max-w-[17.5rem] onload-animation"
					headings={headings}
				/>

				<!-- Contenedor SPA Swup con cálculo de Sticky Footer garantizado -->
				<main
					id="swup-container"
					class="transition-swup-fade flex flex-col min-w-0"
				>
					<div
						id="content-wrapper"
						class="onload-animation flex flex-col flex-1"
						style={`min-height: calc(100vh - ${mainPanelTop} - 2rem);`}
					>
						<!-- Contenido dinámico inyectado por las rutas -->
						<div class="flex-1">
							<slot />
						</div>

						<!-- Footer único unificado: siempre anclado al fondo -->
						<footer class="footer mt-auto pt-6 pb-4 premium-reveal">
							<Footer />
						</footer>
					</div>
				</main>
			</div>

			<BackToTop />
		</div>
	</div>

	<!-- Tabla de contenidos flotante (Pantallas ultra-anchas) -->
	<div class="absolute w-full z-0 hidden 2xl:block" aria-hidden="true">
		<div class="relative max-w-[var(--page-width)] mx-auto">
			{siteConfig.toc.enable && (
				<div
					id="toc-wrapper"
					class:list={[
						"hidden lg:block transition-all absolute top-0 -right-[var(--toc-width)] w-[var(--toc-width)] items-center",
						{ "toc-hide": siteConfig.banner.enable },
					]}
				>
					<div
						id="toc-inner-wrapper"
						class="fixed top-14 w-[var(--toc-width)] h-[calc(100vh_-_20rem)] overflow-y-auto overflow-x-hidden hide-scrollbar"
					>
						<div id="toc" class="w-full h-full transition-swup-fade">
							<div class="h-8 w-full"></div>
							<TOC headings={headings} />
							<div class="h-8 w-full"></div>
						</div>
					</div>
				</div>
			)}

			{!siteConfig.toc.enable && <div id="toc" />}
		</div>
	</div>
</Layout>
